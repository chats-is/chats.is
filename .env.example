# NODE_ENV=

# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
APP_SECRET=
# The origin the app answers from. On Vercel set this to the production domain.
BETTER_AUTH_URL=
AUTH_SECRET=

# Create a GitHub OAuth app here: https://github.com/settings/applications/new
# Authorization callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ENABLED=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Create a OAuth Client ID here: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# Enable or disable Google login. Set to "true" to enable, "false" to disable.
AUTH_GOOGLE_ENABLED=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email OTP
AUTH_EMAIL_ENABLED=
RESEND_API_KEY=
EMAIL_FROM=

# Postgres
DATABASE_URL=

# Blob Store
BLOB_READ_WRITE_TOKEN=

# Upstash pub/sub latency (~360ms/round-trip) is too slow for resumable-stream's
# 1s ack handshake; use a low-latency Redis for resumable chat streams.
# REDIS_URL=
REDIS_URL=

# Upload Path
# VITE_UPLOAD_PATH=

# Umami
# UMAMI_SCRIPT_URL=
# UMAMI_WEBSITE_ID=

# Stripe keys, used when a plan is sold through Stripe. They turn nothing on:
# the subscriptions feature is switched in the console's Settings. Webhook endpoint:
# {BETTER_AUTH_URL}/api/payments/stripe/webhook
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Paddle keys, for plans sold through Paddle. The client-side token opens the
# checkout on the app's page {BETTER_AUTH_URL}/pay/paddle, which is Paddle's
# default payment link; a sandbox token (test_...) uses Paddle's sandbox.
# Webhook endpoint: {BETTER_AUTH_URL}/api/payments/paddle/webhook
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_CLIENT_TOKEN=

# Lemon Squeezy keys and the store plans are sold from. A test-mode API key
# works on test-mode data. Webhook endpoint:
# {BETTER_AUTH_URL}/api/payments/lemonsqueezy/webhook
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_STORE_ID=
